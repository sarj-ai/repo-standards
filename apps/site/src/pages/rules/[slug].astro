---
import { siteHref } from '../../lib/site';
import RulePager from '@sarj/design/RulePager.astro';
import { Code } from '@astrojs/starlight/components';

import ReferencePage from '../../components/reference-page.astro';
import RuleExamplePair from '../../components/rule-example-pair.astro';
import RuleTypeMark from '../../components/rule-type-mark.astro';
import {
  catalog,
  rulePage,
  type Rule,
} from '../../lib/catalog';
import { sourceRevision } from '../../lib/source-revision';
import { ruleDescription, ruleExamples } from '../../lib/rule-view';

export function getStaticPaths() {
  return catalog.rules.map((rule) => ({
    params: { slug: rule.slug },
    props: { rule },
  }));
}

interface Props { rule: Rule }
const { rule } = Astro.props;
const sourceUrl = `${catalog.product["repository_url"]}/blob/${sourceRevision}/${rule.source.path}`;
const ruleJsonUrl = siteHref(`/api/rules/${rule["rule_id"].split('/').map(encodeURIComponent).join('/')}.json`);
const { category, topic, previous, next } = rulePage(rule);
const description = ruleDescription(rule);
const examples = ruleExamples(rule);
const [primaryExample, ...additionalExamples] = examples;
const categoryUrl = siteHref(`/rules/categories/${encodeURIComponent(rule["category_id"])}/`);
const referenceLinks = [...new Set(rule.references)].map((href) => ({
  href,
  label: new URL(href).hostname.replace(/^www\./, ''),
}));
---

<ReferencePage
  title={rule.slug}
  description={description}
>
  <article
    class="rule-detail"
    data-rule-page
    data-rule-id={rule["rule_id"]}
    data-rule-category={rule["category_id"]}
    data-rule-topic={rule["topic_id"]}
  >
    <header class="rule-detail__header">
      <div class="rule-detail__toolbar">
        <nav class="rule-breadcrumb" aria-label="Breadcrumb">
          <a class="rule-breadcrumb__category" href={categoryUrl}>
            <RuleTypeMark categoryId={rule["category_id"]} label={category.category.label} decorative />
            <span>{category.category.label}</span>
          </a>
          <span aria-hidden="true">·</span>
          <span class="rule-breadcrumb__topic">{topic.topic.label}</span>
        </nav>
        <RulePager
          previous={previous ? { href: previous.href, label: previous.rule.slug } : null}
          next={next ? { href: next.href, label: next.rule.slug } : null}
        />
      </div>

      <h1>{rule.slug}</h1>
      <p class="lede" data-rule-description>{description}</p>
      <div class="rule-header-links" aria-label="Rule links">
        <span class:list={['rule-fact', `severity--${rule["default_severity"]}`]}>{rule["default_severity"]}</span>
        <a href="#enable-rule">Enable rule</a>
        <code>{rule["rule_id"]}</code>
        <a href={sourceUrl}>Rule source</a>
        <a href={ruleJsonUrl}>Rule JSON</a>
      </div>
    </header>

    {primaryExample !== undefined && (
      <section class="examples-section" aria-labelledby="examples">
        <h2 id="examples">Examples</h2>
        <div class="examples-list"><RuleExamplePair example={primaryExample} /></div>
        {additionalExamples.length > 0 && (
          <details class="more-examples">
            <summary>More cases <span>{additionalExamples.length}</span></summary>
            <div class="examples-list">
              {additionalExamples.map((example) => <RuleExamplePair example={example} />)}
            </div>
          </details>
        )}
      </section>
    )}

    <section class="rule-activation" aria-labelledby="enable-rule">
      <h2 id="enable-rule">Enable this rule</h2>
      <p>Add the stable ID to <code>enabled_rules</code> in your tracked <code>.repo-standards/repository.toml</code>:</p>
      <Code code={`enabled_rules = ["${rule["rule_id"]}"]`} lang="toml" frame="none" wrap />
      <p>This selects only this rule. To retain the defaults, also include <code>repository/artifacts/untyped-javascript</code> and <code>repository/artifacts/bespoke-iac-verifiers</code>, along with any existing IDs. Omitted or empty selections use the defaults. <a href={siteHref('/getting-started/#enable-rules')}>Setup and staged checks</a></p>
    </section>

    {referenceLinks.length > 0 && (
      <details class="disclosure">
        <summary>References</summary>
        <ul>{referenceLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul>
      </details>
    )}
  </article>
</ReferencePage>
