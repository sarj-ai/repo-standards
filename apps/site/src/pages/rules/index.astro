---
import ReferencePage from '../../components/reference-page.astro';
import RuleDirectory from '../../components/rule-directory.astro';
import { referenceCatalog } from '../../lib/catalog';
import { siteHref } from '../../lib/site';
import Breadcrumbs from '@sarj/design/Breadcrumbs.astro';

const rows = referenceCatalog.flatMap((category) => category.topics.flatMap((topic) => topic.rules));
---

<ReferencePage title="Rules" description="Repository rules available for explicit activation.">
  <header class="directory-heading">
    <h1 class="engineering-visually-hidden">Rules</h1>
    <Breadcrumbs ancestors={[{ label: 'Repo Standards', href: siteHref('/') }]} current="Rules" />
  </header>
  <RuleDirectory rows={rows} />
</ReferencePage>
