---
import { siteHref } from '../lib/site';
import ReferencePage from '../components/ReferencePage.astro';
import { catalog } from '../lib/catalog';
---

<ReferencePage title="Page not found" description={catalog.product.summary} hasSidebar={false} noindex>
  <div class="not-found">
    <h1>Page not found</h1>
    <p>That address does not match a page.</p>
    <a class="primary-action" href={siteHref("/rules/")}>Browse rules</a>
  </div>
</ReferencePage>
