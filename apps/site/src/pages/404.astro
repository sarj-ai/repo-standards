---
import { siteHref } from '../lib/site';
import ReferencePage from '../components/reference-page.astro';
import { catalog } from '../lib/catalog';
---

<ReferencePage title="Page not found" description={catalog.product.summary} hasSidebar={false} noindex>
  <div class="not-found">
    <h1>Page not found</h1>
    <p>This page may have moved. Choose a starting point below.</p>
    <div class="hero-actions">
      <a class="primary-action" href={siteHref('/getting-started/')}>Get started</a>
      <a class="secondary-action" href={siteHref('/rules/')}>Find a rule</a>
      <a class="secondary-action" href={siteHref('/cli/')}>CLI reference</a>
    </div>
  </div>
</ReferencePage>
