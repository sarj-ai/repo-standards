---
import { siteHref } from '../lib/site';

import ReferencePage from '../components/ReferencePage.astro';
---

<ReferencePage title="Repo Standards" description="Check repository structure, pull-request size, and Git policies from exact Git evidence.">
  <article class="overview">
    <header class="hero">
      <p class="eyebrow">Repository policy</p>
      <h1>Repo Standards</h1>
      <p class="lede">Check repository structure, pull-request size, and Git history from exact Git evidence.</p>
      <div class="hero-actions">
        <a class="primary-action" href={siteHref('/getting-started/')}>Get started <span aria-hidden="true">→</span></a>
        <a class="secondary-action" href={siteHref('/rules/')}>Browse rules</a>
      </div>
    </header>
  </article>
</ReferencePage>
