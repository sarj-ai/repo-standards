{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarj-repo-standards",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "repo-standards.sarj.ai",
      "custom_domain": true
    },
    {
      "pattern": "engineering.sarj.ai/projects/repo-standards",
      "zone_name": "sarj.ai"
    },
    {
      "pattern": "engineering.sarj.ai/projects/repo-standards/*",
      "zone_name": "sarj.ai"
    }
  ],
  "main": "./src/worker.ts"
}
