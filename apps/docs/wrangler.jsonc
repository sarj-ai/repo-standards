{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarj-repo-standards",
  "compatibility_date": "2026-08-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "repo-standards.sarj.ai",
      "custom_domain": true
    }
  ]
}
