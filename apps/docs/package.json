{
  "name": "@sarj/repo-standards-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "node ./scripts/generate-catalog.ts",
    "build": "npm run catalog && npm run typecheck && astro build && node ./scripts/finalize-cloudflare-artifacts.ts",
    "check": "npm run catalog && npm run typecheck",
    "deploy": "wrangler deploy",
    "dev": "npm run catalog && astro dev",
    "lint": "npm run catalog && eslint . --max-warnings 0",
    "preview": "astro preview",
    "test": "node --test ./scripts/verify-deployment.test.ts",
    "typecheck": "astro check && tsc --project tsconfig.node.json",
    "verify:deployment": "node ./scripts/verify-deployment.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@sarj/design": "0.5.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@sarj/eslint-plugin": "16.26.2",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "jiti": "2.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@astrojs/markdown-satteri": "0.4.5",
    "sharp": "0.35.5",
    "postcss-nested": {
      "postcss-selector-parser": "7.1.7"
    },
    "@sarj/design": {
      "@astrojs/starlight": "$@astrojs/starlight"
    }
  },
  "packageManager": "npm@12.2.1"
}
