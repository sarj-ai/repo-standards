{
  "name": "@sarj/repo-standards-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "node ./scripts/generate-catalog.ts",
    "build": "npm run catalog && npm run typecheck && astro build && node ./scripts/finalize-cloudflare-artifacts.ts",
    "check": "npm run catalog && npm run typecheck",
    "deploy": "wrangler deploy",
    "dev": "npm run catalog && astro dev",
    "lint": "npm run catalog && eslint . --max-warnings 0",
    "preview": "astro preview",
    "test": "node --test ./scripts/verify-deployment.test.ts",
    "typecheck": "astro check && tsc --project tsconfig.node.json",
    "verify:deployment": "node ./scripts/verify-deployment.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.11",
    "@sarj/design": "0.5.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@eslint/js": "10.0.1",
    "@sarj/eslint-plugin": "16.2.4",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "jiti": "2.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@astrojs/markdown-satteri": "0.3.6",
    "sharp": "0.35.4"
  }
}
