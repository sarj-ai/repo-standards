---
import CodeComparison from '@sarj/design/CodeComparison.astro';

import type { RuleExampleView } from '../lib/rule-view';

interface Props { example: RuleExampleView }
const { example } = Astro.props;
---

<CodeComparison
  id={`example-${example.exampleId}`}
  title={example.title}
  before={{
    label: `Before — rejected · ${example.expectedSeverity}`,
    files: [{ source: example.before, language: example.language, marks: example.marks.before }],
  }}
  after={{
    label: 'After — preferred',
    files: [{ source: example.after, language: example.language, marks: example.marks.after }],
  }}
/>
