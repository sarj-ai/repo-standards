---
import SharedReferencePage from '@sarj/docs-ui/ReferencePage.astro';

import { referenceSidebar } from '../lib/catalog';

interface Props {
  title: string;
  description: string;
  pagefind?: boolean;
  noindex?: boolean;
  hasSidebar?: boolean;
}

const {
  title,
  description,
  pagefind = true,
  noindex = false,
  hasSidebar = true,
} = Astro.props;
const discovery = noindex ? 'unlisted' : pagefind ? 'searchable' : 'navigation-only';
---

<SharedReferencePage
  title={title}
  description={description}
  sidebar={referenceSidebar()}
  discovery={discovery}
  hasSidebar={hasSidebar}
>
  <slot />
</SharedReferencePage>
