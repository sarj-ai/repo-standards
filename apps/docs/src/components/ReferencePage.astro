---
import SharedReferencePage from '@sarj/design/ReferencePage.astro';

import { referenceSidebar } from '../lib/catalog';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hasSidebar?: boolean;
}

const {
  title,
  description,
  noindex = false,
  hasSidebar = true,
} = Astro.props;
---

<SharedReferencePage
  title={title}
  description={description}
  sidebar={referenceSidebar()}
  indexable={!noindex}
  hasSidebar={hasSidebar}
>
  <slot />
</SharedReferencePage>
