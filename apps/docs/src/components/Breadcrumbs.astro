---
import SharedBreadcrumbs from '@sarj/docs-ui/Breadcrumbs.astro';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const current = items.at(-1);
if (current === undefined || current.href !== undefined) throw new TypeError('Breadcrumbs require one unlinked current item.');
const ancestors = items.slice(0, -1).map((item) => {
  if (item.href === undefined) throw new TypeError('Breadcrumb ancestors require links.');
  return { label: item.label, href: item.href };
});
---

<SharedBreadcrumbs ancestors={ancestors} current={current.label} />
