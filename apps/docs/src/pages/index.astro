---
import { Code } from '@astrojs/starlight/components';

import ReferencePage from '../components/ReferencePage.astro';
import { catalog } from '../lib/catalog';

const quickStart = `uvx --from ${catalog.product.distribution} repo-standards pull-request size . --base origin/main --head HEAD`;
---

<ReferencePage title={catalog.product.title} description={catalog.product.summary} pagefind={false}>
  <article class="about-page">
    <h1>About</h1>
    <p>Repository standards should be easy to understand before they are enforced.</p>
    <p>Repo Standards measures pull-request size today. Every lint rule stays disabled while it is under review.</p>
    <p><a href="/review/">Review pending rules</a> or use the read-only command below.</p>

    <section aria-labelledby="quick-start">
      <h2 id="quick-start">Quick start</h2>
      <Code code={quickStart} lang="bash" frame="terminal" wrap />
      <p><a href="/cli/">CLI reference</a></p>
    </section>
  </article>
</ReferencePage>
