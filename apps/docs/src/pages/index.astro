---
import { Code } from '@astrojs/starlight/components';

import ReferencePage from '../components/ReferencePage.astro';
import { catalog } from '../lib/catalog';

const quickStart = `uvx --from ${catalog.product.distribution} repo-standards pull-request size . --base origin/main --head HEAD`;
---

<ReferencePage title="About" description={catalog.product.summary}>
  <article class="about-page sarj-about-page">
    <h1>About</h1>
    <p>Repository standards should be easy to understand before they are enforced.</p>
    <p>Repo Standards checks repository structure, pull-request size, commit messages, and reviewable Git history.</p>
    <p><a href="/rules/">Browse rules</a> or <a href="/git-policies/">understand Git policies</a>.</p>

    <section aria-labelledby="quick-start">
      <h2 id="quick-start">Quick start</h2>
      <Code code={quickStart} lang="bash" frame="terminal" wrap />
      <p><a href="/cli/">CLI reference</a></p>
    </section>

    <section class="sarj-related-standards" aria-labelledby="related-standards">
      <h2 id="related-standards">Related standards</h2>
      <p><a href="https://code-standards.sarj.ai/">Explore Sarj Code Standards</a> for deterministic Python, TypeScript, SQL, IaC, and text rules.</p>
    </section>
  </article>
</ReferencePage>
