---
import { Code } from '@astrojs/starlight/components';
import RulePager from '@sarj/docs-ui/RulePager.astro';

import ReferencePage from '../../components/ReferencePage.astro';
import RuleTypeMark from '../../components/RuleTypeMark.astro';
import {
  catalog,
  rulePage,
  type Rule,
} from '../../lib/catalog';
import { sourceRevision } from '../../lib/build';
import { exampleExcerpt } from '../../lib/example-excerpt';

export function getStaticPaths() {
  return catalog.rules.map((rule) => ({
    params: { slug: rule.slug },
    props: { rule },
  }));
}

interface Props { rule: Rule }
const { rule } = Astro.props;
const sourceUrl = `${catalog.product.repository_url}/blob/${sourceRevision}/${rule.source.path}`;
const ruleJsonUrl = `/api/v6/rules/${rule.rule_id.split('/').map(encodeURIComponent).join('/')}.json`;
const { category, topic, previous, next } = rulePage(rule);
const categoryUrl = rule.review.status === 'pending'
  ? '/review/'
  : `/rules/categories/${encodeURIComponent(rule.category_id)}/`;
const referenceLinks = [...new Set(rule.references)].map((href) => ({
  href,
  label: new URL(href).hostname.replace(/^www\./, ''),
}));
---

<ReferencePage
  title={rule.slug}
  description={rule.summary}
  noindex={rule.review.status === 'pending'}
>
  <article
    class="rule-detail"
    data-rule-page
    data-rule-id={rule.rule_id}
    data-rule-category={rule.category_id}
    data-rule-topic={rule.topic_id}
  >
    <header class="rule-detail__header">
      <div class="rule-detail__toolbar">
        <nav class="rule-breadcrumb" aria-label="Breadcrumb">
          <a class="rule-breadcrumb__category" href={categoryUrl}>
            <RuleTypeMark categoryId={rule.category_id} label={category.category.label} decorative />
            <span>{category.category.label}</span>
          </a>
          <span aria-hidden="true">·</span>
          <span class="rule-breadcrumb__topic">{topic.topic.label}</span>
        </nav>
        <RulePager
          previous={previous ? { href: previous.href, label: previous.rule.slug } : null}
          next={next ? { href: next.href, label: next.rule.slug } : null}
        />
      </div>

      <h1>{rule.slug}</h1>
      <p class="lede" data-rule-summary>{rule.summary}</p>
      <div class="rule-header-links" aria-label="Rule links">
        <code>{rule.rule_id}</code>
        <a href={sourceUrl}>Rule source</a>
        <a href={ruleJsonUrl}>Rule JSON</a>
        <a href="/api/v6/catalog.json">Catalog JSON</a>
        {referenceLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>
    </header>

    <section class="rule-prose" aria-label="Rule guidance">
      <div>
        <h2>Why</h2>
        <p>{rule.impact}</p>
      </div>
      <div>
        <h2>Fix</h2>
        <p>{rule.remediation.summary}</p>
      </div>
    </section>

    {rule.examples.length > 0 && (
      <section class="examples-section" aria-labelledby="examples">
        <h2 id="examples">Examples</h2>
        <div class="examples-list">
          {rule.examples.map((example) => {
            const excerpt = exampleExcerpt(example.flagged, example.passes, example.language);
            return (
              <section class="example-pair" aria-label={example.title} data-example-pair={example.fixture_id}>
                <h3 class="example-pair-title">{example.title}</h3>
                <div class="examples-grid">
                  <figure class="example example--bad" data-example-kind="flagged">
                    <figcaption><span>Before · {example.severity}</span></figcaption>
                    <Code code={excerpt.flagged} lang={example.language} wrap />
                  </figure>
                  <figure class="example example--good" data-example-kind="passes">
                    <figcaption><span>After</span></figcaption>
                    <Code code={excerpt.passes} lang={example.language} wrap />
                  </figure>
                </div>
              </section>
            );
          })}
        </div>
      </section>
    )}
  </article>
</ReferencePage>
