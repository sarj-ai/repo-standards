---
import ReferencePage from '../../components/ReferencePage.astro';
import RuleDirectory from '../../components/RuleDirectory.astro';
import { referenceCatalog } from '../../lib/catalog';

const description = 'Repository rules available for explicit activation.';
const rows = referenceCatalog.flatMap((category) => category.topics.flatMap((topic) => topic.rules));
---

<ReferencePage title="Rules" description={description}>
  <header class="directory-header">
    <h1>Rules</h1>
    <p class="lede">{description}</p>
  </header>
  <RuleDirectory rows={rows} />
</ReferencePage>
