---
import { Code } from '@astrojs/starlight/components';

import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ReferencePage from '../../../components/ReferencePage.astro';
import RuleTypeMark from '../../../components/RuleTypeMark.astro';
import {
  catalog,
  rulePage,
  type Rule,
} from '../../../lib/catalog';
import { sourceRevision } from '../../../lib/build';
import { exampleExcerpt } from '../../../lib/example-excerpt';

export function getStaticPaths() {
  return catalog.rules.map((rule) => {
    const [family, ...id] = rule.rule_id.split('/');
    return { params: { family, id: id.join('/') }, props: { rule } };
  });
}

interface Props { rule: Rule }
const { rule } = Astro.props;
const sourceUrl = `${catalog.product.repository_url}/blob/${sourceRevision}/${rule.source.path}`;
const page = rulePage(rule);
const { category, topic, previous, next } = page;
const directoryHref = rule.review.status === 'pending' ? '/review/' : '/rules/';
const example = rule.examples[0];
const excerpt = exampleExcerpt(example.flagged, example.passes, example.language);
const limits = [...rule.non_goals, ...rule.false_positive_controls];
const severities = [...new Set(rule.examples.map((value) => value.severity))];
---

<ReferencePage
  title={rule.title}
  description={rule.summary}
  pagefind={rule.review.status !== 'pending'}
  noindex={rule.review.status === 'pending'}
>
  <article class="rule-detail" data-rule-page data-rule-id={rule.rule_id} data-rule-category={rule.category_id} data-rule-topic={rule.topic_id}>
    <header class="rule-detail__header">
      <div class="rule-detail__toolbar">
        <Breadcrumbs items={[
          { label: rule.review.status === 'pending' ? 'Review' : 'Rules', href: directoryHref },
          { label: rule.title },
        ]} />
        <nav class="rule-stepper" aria-label="Rule navigation" data-rule-nav>
          {previous && <a rel="prev" href={previous.href} aria-label={`Previous rule: ${previous.rule.title}`} title={previous.rule.title}>←</a>}
          {next && <a rel="next" href={next.href} aria-label={`Next rule: ${next.rule.title}`} title={next.rule.title}>→</a>}
        </nav>
      </div>
      <div class="rule-title-row">
        <RuleTypeMark categoryId={rule.category_id} label={category.category.label} />
        <h1>{rule.title}</h1>
      </div>
      <p class="lede" data-rule-summary>{rule.summary}</p>
      <div class="rule-header-links" aria-label="Rule classification">
        <code class="rule-id">{rule.rule_id}</code>
        <span class="rule-fact">{topic.topic.label}</span>
        <span class:list={['rule-fact', `severity--${rule.default_severity}`]}>default {rule.default_severity}</span>
        {severities.length > 1 && <span class="rule-fact">cases {severities.join(' + ')}</span>}
        <a href={sourceUrl}>Rule source</a>
      </div>
    </header>

    <section class="rule-prose" aria-label="Rule explanation">
      <div><h2>Detects</h2><p>{rule.detects}</p></div>
      <div><h2>Why</h2><p>{rule.impact}</p></div>
      <div><h2>Fix</h2><p>{rule.remediation.summary}</p></div>
    </section>

    <section class="examples-section" aria-labelledby="examples">
      <h2 id="examples">Examples</h2>
      <h3 class="example-pair-title">{example.title}</h3>
      <div class="examples-grid" data-example-pair={example.fixture_id}>
          <figure class="example example--bad" data-example-kind="flagged">
            <figcaption><span>Before · {example.severity}</span></figcaption>
            <Code code={excerpt.flagged} lang={example.language} wrap />
          </figure>
          <figure class="example example--good" data-example-kind="passes">
            <figcaption><span>After</span></figcaption>
            <Code code={excerpt.passes} lang={example.language} wrap />
          </figure>
      </div>
      {excerpt.compacted && (
        <details class="full-example-pair">
          <summary>Full executable inputs</summary>
          <div class="examples-grid">
            <Code code={example.flagged} lang={example.language} wrap />
            <Code code={example.passes} lang={example.language} wrap />
          </div>
        </details>
      )}
    </section>

    <details class="rule-more">
      <summary>More examples and evidence</summary>
      {rule.examples.slice(1).map((additional) => (
        <section class="additional-example" aria-label={additional.title}>
          <h3 class="example-pair-title">{additional.title}</h3>
          <div class="examples-grid" data-example-pair={additional.fixture_id}>
            <figure class="example example--bad" data-example-kind="flagged">
              <figcaption><span>Before · {additional.severity}</span></figcaption>
              <Code code={additional.flagged} lang={additional.language} wrap />
            </figure>
            <figure class="example example--good" data-example-kind="passes">
              <figcaption><span>After</span></figcaption>
              <Code code={additional.passes} lang={additional.language} wrap />
            </figure>
          </div>
        </section>
      ))}
      <dl>
        <div><dt>Inspects</dt><dd><ul>{rule.evidence_required.map((value) => <li>{value}</li>)}</ul></dd></div>
        {limits.length > 0 && <div><dt>Limits</dt><dd><ul>{limits.map((value) => <li>{value}</li>)}</ul></dd></div>}
        <div><dt>Steps</dt><dd><ol>{rule.remediation.steps.map((value) => <li>{value}</li>)}</ol></dd></div>
        <div><dt>Verify</dt><dd><ul>{rule.remediation.validation.map((value) => <li>{value}</li>)}</ul></dd></div>
      </dl>
      {rule.references.length > 0 && <p>{rule.references.map((value, index) => <><a href={value}>{new URL(value).hostname}</a>{index < rule.references.length - 1 ? ' · ' : ''}</>)}</p>}
    </details>
  </article>
</ReferencePage>
