---
import { Code } from '@astrojs/starlight/components';

import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ReferencePage from '../../../components/ReferencePage.astro';
import {
  catalog,
  rulePage,
  type Rule,
} from '../../../lib/catalog';
import { sourceRevision } from '../../../lib/build';

export function getStaticPaths() {
  return catalog.rules.map((rule) => {
    const [family, ...id] = rule.rule_id.split('/');
    return { params: { family, id: id.join('/') }, props: { rule } };
  });
}

interface Props { rule: Rule }
const { rule } = Astro.props;
const sourceUrl = `${catalog.product.repository_url}/blob/${sourceRevision}/${rule.source.path}`;
const page = rulePage(rule);
const { category, topic, previous, next } = page;
const limits = [...rule.non_goals, ...rule.false_positive_controls];
const directoryHref = rule.review.status === 'pending' ? '/review/' : '/rules/';
---

<ReferencePage title={rule.title} description={rule.summary}>
  <article class="rule-detail" data-rule-page data-rule-id={rule.rule_id} data-rule-category={rule.category_id} data-rule-topic={rule.topic_id}>
    <header class="rule-detail__header">
      <Breadcrumbs items={[
      { label: rule.review.status === 'pending' ? 'Review' : 'Rules', href: directoryHref },
      { label: category.category.label, href: directoryHref },
      { label: topic.topic.label, href: directoryHref },
      { label: rule.title },
      ]} />
      <code class="rule-id">{rule.rule_id}</code>
      <h1>{rule.title}</h1>
      <p class="lede" data-rule-summary>{rule.summary}</p>
      <div class="rule-facts" aria-label="Rule classification">
        <span class:list={['rule-fact', `severity--${rule.default_severity}`]}>{rule.default_severity}</span>
        <span class="rule-fact">{rule.review.status}</span>
        {rule.lifecycle.status !== 'stable' && <span class="rule-fact">{rule.lifecycle.status}</span>}
      </div>
    </header>

    {rule.review.status === 'pending' && (
      <section class="review-checklist" aria-labelledby="review-checklist">
        <h2 id="review-checklist">Review checklist</h2>
        <ul>
          {['Name', 'Description', 'Trigger', 'Impact', 'Remediation', 'Flagged case', 'Passing case'].map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <section aria-labelledby="examples">
      <h2 id="examples">Examples</h2>
      {rule.examples.map((example) => (
        <div class="examples" data-example-pair={example.fixture_id}>
          <figure class="example example--bad" data-example-kind="flagged">
            <figcaption><strong>Flagged</strong><span>Fails</span></figcaption>
            <Code code={example.flagged} lang={example.language} wrap />
          </figure>
          <figure class="example example--good" data-example-kind="passes">
            <figcaption><strong>Passes</strong><span>Clean</span></figcaption>
            <Code code={example.passes} lang={example.language} wrap />
          </figure>
        </div>
      ))}
    </section>

    <dl class="rule-explainer">
      <div><dt>Why</dt><dd>{rule.impact}</dd></div>
      <div><dt>Detects</dt><dd>{rule.detects}</dd></div>
      <div><dt>Inspects</dt><dd><ul>{rule.evidence_required.map((value) => <li>{value}</li>)}</ul></dd></div>
      {limits.length > 0 && <div><dt>Limits</dt><dd><ul>{limits.map((value) => <li>{value}</li>)}</ul></dd></div>}
      <div><dt>Fix</dt><dd><p>{rule.remediation.summary}</p><ol>{rule.remediation.steps.map((value) => <li>{value}</li>)}</ol></dd></div>
      <div><dt>Verify</dt><dd><ul>{rule.remediation.validation.map((value) => <li>{value}</li>)}</ul></dd></div>
    </dl>

    <nav class="rule-navigation" aria-label="Rule navigation" data-rule-nav>
      {previous && <a rel="prev" href={previous.href}><span>Previous in {topic.topic.label}</span><strong>{previous.rule.title}</strong></a>}
      {next && <a rel="next" href={next.href}><span>Next in {topic.topic.label}</span><strong>{next.rule.title}</strong></a>}
    </nav>

    <footer class="rule-footer">
      {rule.references.length > 0 && <p>{rule.references.map((value, index) => <><a href={value}>Reference {index + 1}</a>{index < rule.references.length - 1 ? ' · ' : ''}</>)}</p>}
      <p><a href={sourceUrl}>Source</a> · Rule version {rule.rule_version}</p>
    </footer>
  </article>
</ReferencePage>
