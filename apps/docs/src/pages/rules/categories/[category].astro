---
import Breadcrumbs from '@sarj/docs-ui/Breadcrumbs.astro';

import ReferencePage from '../../../components/ReferencePage.astro';
import { approvedRules, referenceCatalog, type CategoryView } from '../../../lib/catalog';
import { ruleDescription } from '../../../lib/rule-view';

export function getStaticPaths() {
  const approvedIds = new Set(approvedRules.map((rule) => rule.rule_id));
  return referenceCatalog
    .filter((category) => category.topics.some((topic) => topic.rules.some(({ rule }) => approvedIds.has(rule.rule_id))))
    .map((category) => ({
    params: { category: category.category.category_id },
    props: { category },
    }));
}

interface Props { category: CategoryView }
const { category } = Astro.props;
const approvedIds = new Set(approvedRules.map((rule) => rule.rule_id));
const topics = category.topics
  .map(({ topic, rules }) => ({ topic, rules: rules.filter(({ rule }) => approvedIds.has(rule.rule_id)) }))
  .filter(({ rules }) => rules.length > 0);
const approvedCount = topics.reduce((total, topic) => total + topic.rules.length, 0);
---

<ReferencePage title={category.category.label} description={`${approvedCount} approved repository rules.`}>
  <Breadcrumbs ancestors={[{ label: 'Rules', href: '/rules/' }]} current={category.category.label} />
  <h1 class="sarj-visually-hidden">{category.category.label}</h1>
  <div class="rule-catalog" data-category-id={category.category.category_id}>
    {topics.length === 0 && <div class="directory-empty-state"><p>No rules in this area are approved yet.</p><a href="/review/">Review pending rules</a></div>}
    {topics.map(({ topic, rules }) => {
      return (
        <section class="rule-topic" aria-labelledby={`topic-${topic.topic_id}`}>
          <h2 id={`topic-${topic.topic_id}`}>{topic.label}</h2>
          <div class="rule-list">
            {rules.map(({ rule, href }) => (
              <a class="rule-row" href={href} data-rule-id={rule.rule_id}>
                <strong>{rule.title}</strong>
                <span>{ruleDescription(rule)}</span>
                <code>{rule.rule_id}</code>
                <span class:list={['severity', `severity--${rule.default_severity}`]}>{rule.default_severity}</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</ReferencePage>
